SPOONACULAR_API_KEY=
GEMINI_API_KEY=
DAILY_SEARCH_LIMIT=50
DAILY_DETECT_LIMIT=30
DAILY_SWAP_LIMIT=100
# Deployed frontend URL(s), comma-separated, e.g. https://smart-meal-planner.example.com
# (any localhost port is always allowed)
ALLOWED_ORIGINS=
# Testing recipe filters without spending Spoonacular quota (leave blank normally):
# SAVE_SPOONACULAR=1 saves each successful search to sample_data/spoonacular_capture.json,
# USE_CAPTURE=1 replays that saved file instead of calling Spoonacular
SAVE_SPOONACULAR=
USE_CAPTURE=
